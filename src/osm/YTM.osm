    <tag k="addr:city" v="Hong Kong"/>
    <tag k="addr:district" v="尖沙咀 Tsim Sha Tsui"/>
    <tag k="addr:housenumber" v="Rm 08-09, 10/F, Mira Place Tower A"/>
    <tag k="addr:street" v="彌敦道 Nathan Road"/>
    <tag k="description" v="&quot;壹森健康醫療有別於一般傳統體檢中心，而是您壹家人的健康守護站！在病痛出現前做好監察和預防，遠遠勝於不適時才檢查和治療。&#x0a;&#x0a;因此我們堅守品牌理念 — 健康需要管理，並致力推動家庭健康管理新概念，守護每壹個人、每壹個家的健康狀況，用醫學、科技和營養學三大專業範疇，提供全方位的健康管理和指導服務，為您和家人的未來建立家庭健康管理藍圖。這正是我們的使命 —— 令每壹個家都擁有健康森林，每壹個人都以最健康狀態實現理想生活。&quot;"/>
    <tag k="email" v="info@lyhealthy.com"/>
    <tag k="name" v="壹森健康醫療 Life Young Health"/>
    <tag k="name:en" v="Life Young Health"/>
    <tag k="name:zh" v="壹森健康醫療"/>
    <tag k="office" v="medical_center"/>
    <tag k="opening_hours" v="Mo-Sa 08:30-19:30"/>
    <tag k="phone" v="+852 2523 8308"/>
    <tag k="website" v="https://lyhealthy.com/"/>
  </node>
